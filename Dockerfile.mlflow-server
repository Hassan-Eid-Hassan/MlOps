# MLflow tracking server + model registry, packaged so it can run as a
# regular pod on Kubernetes. This is the actual "MLflow deployed on k8s"
# component: training, evaluation, and registration all talk to this over
# HTTP, and its UI is what you show live for the experiments/registry.
FROM python:3.11-slim

RUN pip install --no-cache-dir mlflow==3.14.0

EXPOSE 5000

# --allowed-hosts/--cors-allowed-origins are wide open here for demo
# convenience (kubectl port-forward, NodePort, whatever's easiest on stage).
# Lock these down to real hostnames before using this anywhere but a demo.
CMD ["mlflow", "server", \
     "--backend-store-uri", "sqlite:////mlflow/mlflow.db", \
     "--default-artifact-root", "/mlflow/artifacts", \
     "--host", "0.0.0.0", \
     "--port", "5000", \
     "--allowed-hosts", "*", \
     "--cors-allowed-origins", "*"]
